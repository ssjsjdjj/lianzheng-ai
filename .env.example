# Prefer the local Model Settings UI. No keys are shipped.
# LLM fields are read from this project's .env; embedding fields need process env.
# Example base URL ends at the provider API prefix, e.g. https://provider.example/v1
LZ_LLM_BASE_URL=https://api.deepseek.com
LZ_LLM_API_KEY=
LZ_LLM_MODEL=deepseek-flash
# Alternatively: DEEPSEEK_API_KEY=
LZ_EMBEDDING_BASE_URL=
LZ_EMBEDDING_API_KEY=
LZ_EMBEDDING_MODEL=
# Optional absolute database path. Default: ./data/lianzheng.sqlite3
# LZ_DATABASE=
